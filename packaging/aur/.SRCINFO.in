pkgbase = zcalld-compat
	pkgdesc = Optional privacy worker and community plugin compatibility for zcalld
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/LIghtJUNction/zcalld-compat
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = go>=1.26.8
	depends = glibc
	optdepends = bun: JavaScript community plugin runtime
	optdepends = git: install pinned Git community sources
	optdepends = zcalld: native gateway and adapters
	options = !lto
	source = zcalld-compat-@VERSION@-source.tar.gz::https://github.com/LIghtJUNction/zcalld-compat/releases/download/v@VERSION@/zcalld-compat-@VERSION@-source.tar.gz
	sha256sums = @SHA256@

pkgname = zcalld-compat
